{
  "name": "@allplay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:vercel": "npm run build && esbuild src/vercel.ts --bundle --platform=node --format=cjs --packages=external --alias:@allplay/shared=../shared/contracts/src/index.ts --outfile=dist/deploy/app.cjs --footer:js=module.exports=module.exports.default;",
    "start": "node ../scripts/start-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ioredis": "6.0.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@allplay/shared": "0.1.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@types/express": "5.0.6",
    "tsx": "4.23.15"
  }
}
