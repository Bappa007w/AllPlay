{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "buildCommand": "npm run build:packages --prefix .. && npm run build"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "npm run build:packages --prefix .. && npm run build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/socket.io", "destination": { "service": "backend" } },
    { "source": "/socket.io/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
