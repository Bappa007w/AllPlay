# Copy to .env at the repository root. All values here are non-secret local defaults.
# Web dev/start uses port 3000. Backend binds only to this machine by default.
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# NODE_ENV is set by each runtime. Do not set it globally for both dev and production.
# Database, admin credentials and object storage are introduced in later approved phases.
