# Copy to .env at the repository root. All values here are non-secret local defaults.
# Web dev/start uses port 3000. Both services accept container and LAN traffic.
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# NODE_ENV is set by each runtime. Do not set it globally for both dev and production.
# In production, set WEB_ORIGIN to the public HTTPS origin (for example,
# https://allplay.example.com). Keep API_INTERNAL_URL private and reachable by Next.js.
# Database, admin credentials and object storage are introduced in later approved phases.

# Local development needs no cloud account. Never put Redis credentials in NEXT_PUBLIC_*.
ROOM_STORE=memory
REDIS_KEY_PREFIX=allplay:local
# For Vercel Production, set these in its dashboard (not in committed files):
# ROOM_STORE=redis
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379
# REDIS_KEY_PREFIX=allplay:production
# WEB_ORIGIN=https://YOUR_PROJECT.vercel.app
# Use Upstash's explicit Free plan, NOT pay-as-you-go. Do not enable paid upgrades.
